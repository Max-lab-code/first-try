---
import { getCollection, render } from 'astro:content';
import Seite from '../../layouts/Seite.astro';
import { arten } from '../../arten';
import Bild from '../../components/Bild.astro';
import { anreichern } from '../../datenbank';

export async function getStaticPaths() {
  const eintraege = await getCollection('eintraege');
  return eintraege.map((eintrag) => ({ params: { id: eintrag.id }, props: { eintrag } }));
}

const { eintrag } = Astro.props;
const { Content } = await render(eintrag);
const d = eintrag.data;
const extra = await anreichern(eintrag);
const von = d.von ?? extra.von;
const jahr = d.jahr ?? extra.jahr;
---

<Seite titel={d.titel}>
  <article>
    <span class="art">{arten[d.art]}</span>
    <h1>{d.titel}</h1>
    <p class="von">{[von, jahr].filter(Boolean).join(', ')}</p>
    <Bild eintrag={eintrag} bildUrl={extra.bildUrl} gross />
    {d.bildnachweis && <p class="nachweis">Bild: {d.bildnachweis}</p>}
    {extra.quelle && <p class="nachweis">Bild und Daten: {extra.quelle}</p>}
    <p class="teaser">{d.teaser}</p>
    <Content />
    {d.link && <p><a href={d.link}>Mehr dazu</a></p>}
    <p class="zurueck"><a href={import.meta.env.BASE_URL}>Zurück zur Liste</a></p>
  </article>
</Seite>

<style>
  article { max-width: 36rem; padding-bottom: 3rem; }
  h1 { margin: 0.5rem 0 0; font-size: 2.2rem; line-height: 1.15; }
  .von { margin: 0.2rem 0 1.5rem; color: var(--grau); }
  .nachweis { margin: -1rem 0 1.5rem; font: 0.8rem system-ui, sans-serif; color: var(--grau); }
  .teaser { font-size: 1.2rem; font-style: italic; }
  .zurueck { margin-top: 2.5rem; font-family: system-ui, sans-serif; font-size: 0.9rem; }
</style>
