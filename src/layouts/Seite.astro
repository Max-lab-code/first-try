---
interface Props {
  titel?: string;
}
const { titel } = Astro.props;
const seitentitel = titel ? `${titel} · Fundstücke` : 'Fundstücke';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
  </head>
  <body>
    <header>
      <a class="logo" href={import.meta.env.BASE_URL}>Fundstücke</a>
      <p class="untertitel">Filme, Bücher, Platten und Ausstellungen, die man sonst nicht findet.</p>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Filmdaten und Poster von <a href="https://www.themoviedb.org">TMDB</a>. Diese Seite nutzt die TMDB-API, ist aber nicht von TMDB unterstützt oder zertifiziert.</p>
      <p>Buchdaten von <a href="https://openlibrary.org">Open Library</a>, Plattendaten von <a href="https://musicbrainz.org">MusicBrainz</a> und dem <a href="https://coverartarchive.org">Cover Art Archive</a>.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --papier: #f6f1e7;
    --tinte: #221f1a;
    --grau: #6b645a;
    --linie: #ddd3c2;
    --akzent: #b4462b;
    --karte: #fffaf1;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --papier: #1b1917;
      --tinte: #eee7da;
      --grau: #a79f92;
      --linie: #38332d;
      --akzent: #e07a5a;
      --karte: #24211e;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--papier);
    color: var(--tinte);
    font: 17px/1.6 Georgia, 'Times New Roman', serif;
  }
  header, main, footer {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  header { padding-top: 2.5rem; padding-bottom: 1.5rem; }
  footer {
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--linie);
    color: var(--grau);
    font: 0.8rem/1.5 system-ui, sans-serif;
  }
  footer p { margin: 0 0 0.4rem; }
  .logo {
    font-size: 2.2rem;
    font-weight: bold;
    color: var(--tinte);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .untertitel { margin: 0.25rem 0 0; color: var(--grau); }
  a { color: var(--akzent); }
  .art {
    font: 600 0.75rem/1 system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--akzent);
  }
</style>
