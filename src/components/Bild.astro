---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

// Zeigt das Bild eines Eintrags. Ohne Bild gibt es ein gestaltetes Motiv je nach Art.
interface Props {
  eintrag: CollectionEntry<'eintraege'>;
  gross?: boolean;
  // Bild aus einer Datenbank (Cover oder Poster)
  bildUrl?: string;
}
const { eintrag, gross = false, bildUrl } = Astro.props;
const { bild, titel, art } = eintrag.data;
---

<div class:list={['bild', `art-${art}`, { gross }]}>
  {bild ? (
    <Image src={bild} alt={titel} widths={[400, 800, 1200]} sizes={gross ? '(max-width: 40rem) 100vw, 36rem' : '(max-width: 40rem) 100vw, 18rem'} />
  ) : bildUrl ? (
    <div class="cover" style={`--cover: url('${bildUrl}')`}>
      <img src={bildUrl} alt={titel} loading="lazy" />
    </div>
  ) : (
    <div class="motiv" aria-hidden="true">
      {art === 'film' && (
        <svg viewBox="0 0 300 200">
          {Array.from({ length: 12 }, (_, i) => <rect x={i * 26 + 4} y="10" width="14" height="10" rx="2" />)}
          {Array.from({ length: 12 }, (_, i) => <rect x={i * 26 + 4} y="180" width="14" height="10" rx="2" />)}
          <circle cx="150" cy="100" r="42" fill="none" stroke-width="3" />
          <path d="M138 80 L172 100 L138 120 Z" />
        </svg>
      )}
      {art === 'buch' && (
        <svg viewBox="0 0 300 200">
          <path d="M150 55 C 120 45, 90 45, 70 52 L70 150 C 90 143, 120 143, 150 153 Z" fill="none" stroke-width="3" />
          <path d="M150 55 C 180 45, 210 45, 230 52 L230 150 C 210 143, 180 143, 150 153 Z" fill="none" stroke-width="3" />
          {[75, 90, 105, 120].map((y) => <path d={`M88 ${y} C 105 ${y - 4}, 122 ${y - 3}, 138 ${y + 2}`} fill="none" stroke-width="2" />)}
        </svg>
      )}
      {art === 'platte' && (
        <svg viewBox="0 0 300 200">
          {[70, 58, 46, 34].map((r) => <circle cx="150" cy="100" r={r} fill="none" stroke-width={r === 70 ? 3 : 1.5} />)}
          <circle cx="150" cy="100" r="16" />
          <circle cx="150" cy="100" r="3" class="loch" />
        </svg>
      )}
      {art === 'ausstellung' && (
        <svg viewBox="0 0 300 200">
          <rect x="95" y="40" width="110" height="120" fill="none" stroke-width="3" />
          <rect x="108" y="53" width="84" height="94" fill="none" stroke-width="1.5" />
          <circle cx="135" cy="85" r="10" />
          <path d="M112 142 L145 105 L165 125 L178 112 L190 142 Z" />
        </svg>
      )}
    </div>
  )}
</div>

<style>
  .bild {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--motiv-grund);
    color: var(--motiv-linie);
  }
  .bild.gross { border-radius: 8px; margin: 1rem 0 1.5rem; }
  .bild :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .motiv { width: 100%; height: 100%; }
  /* Cover und Poster haben andere Formate: ganz zeigen, dahinter unscharf vergrößert */
  .cover {
    position: relative;
    height: 100%;
    background: var(--cover) center / cover;
  }
  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    backdrop-filter: blur(18px) brightness(0.7);
  }
  .bild .cover img {
    position: relative;
    object-fit: contain;
    padding: 0.75rem 0;
    filter: drop-shadow(0 4px 12px rgb(0 0 0 / 0.35));
  }
  svg { width: 100%; height: 100%; }
  svg :global(*) { stroke: currentColor; }
  svg :global(rect:not([fill='none'])),
  svg :global(circle:not([fill='none'])),
  svg :global(path:not([fill='none'])) { fill: currentColor; stroke: none; }
  svg :global(.loch) { fill: var(--motiv-grund); }

  .art-film { --motiv-grund: #1f3b3a; --motiv-linie: #e9c46a; }
  .art-buch { --motiv-grund: #e3b448; --motiv-linie: #3a2a12; }
  .art-platte { --motiv-grund: #2b2340; --motiv-linie: #f28f6b; }
  .art-ausstellung { --motiv-grund: #c65d3b; --motiv-linie: #fbeee0; }
</style>
